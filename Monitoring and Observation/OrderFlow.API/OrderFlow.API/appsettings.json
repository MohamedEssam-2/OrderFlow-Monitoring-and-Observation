{

    "ConnectionStrings": {
        "SqlServer": "Server=.;Database=OrderFlowDb;Trusted_Connection=True;TrustServerCertificate=True;"
    },
    "Redis": {
        "ConnectionString": "localhost:6379"
    },

    //"Logging": {
    //    "LogLevel": {
    //        "Default": "Information",
    //        "Microsoft.AspNetCore": "Warning"
    //    }
    //},
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/orderflow-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7
                }
            }
        ],
        "Enrich": [
            "FromLogContext"
        ]
    },
    "AllowedHosts": "*"
}
